# Chat model served by Ollama, in LiteLLM format
HELPDESK_MODEL=ollama_chat/qwen3:8b
# HELPDESK_MODEL=ollama_chat/llama3.1:8b
OLLAMA_API_BASE=http://localhost:11434

# Embedding model served by Ollama
EMBED_MODEL=nomic-embed-text

# Paths
DOCS_DIR=data/docs
CSV_DIR=data/csv
CHROMA_DIR=chroma_db
CHROMA_COLLECTION=academic_docs
UNANSWERED_LOG=logs/unanswered.jsonl
DRAFTS_DIR=drafts

# Retrieval
TOP_K=5
# Chunks with cosine distance above this are treated as "not found"
MAX_DISTANCE=0.35
